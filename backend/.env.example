# ============================================================================
# GLIDEEARTH BACKEND — ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the `.env` file to version control.
# ============================================================================

# --- Server ---
NODE_ENV=development
PORT=5000

# --- PostgreSQL Database ---
# These values are tuned for the connection pool in src/config/database.js
DB_HOST=localhost
DB_PORT=5432
DB_NAME=glideearth
DB_USER=postgres
DB_PASSWORD=your_password_here

# --- Connection Pool (Advanced Tuning) ---
# Max connections in the pool (matches PgBouncer default_pool_size)
DB_POOL_MAX=20
# Min idle connections kept warm
DB_POOL_MIN=5
# Max milliseconds a client can sit idle before being closed
DB_POOL_IDLE_TIMEOUT_MS=30000
# Max milliseconds to wait for a connection from the pool
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# --- JWT Authentication ---
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# --- CORS ---
CORS_ORIGIN=http://localhost:3000
